{
  "name": "testaro",
  "version": "78.7.0",
  "description": "Run 1300 web accessibility tests from 12 tools and get a standardized report",
  "main": "run.js",
  "scripts": {
    "build:nameComputation": "esbuild src/nameComputation.js --bundle --format=iife --global-name=computeAccessibleName --outfile=dist/nameComputation.js",
    "build": "npm run build:nameComputation",
    "deps": "npm update && npx playwright install && npm run build",
    "renew": "git fetch origin && git reset --hard @{upstream} && npm ci && npx playwright install && npm run build",
    "tests": "node validation/executors/tests",
    "test": "node validation/executors/test",
    "run": "node validation/executors/run",
    "dirWatch": "node validation/executors/dirWatch",
    "netWatch": "node validation/executors/netWatch",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc",
    "prepublishOnly": "npm run build:registry && npm run build:ts",
    "build:registry": "node procs/generateRuleRegistry.js",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YRA-Tech/testaro.git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "testing",
    "automation"
  ],
  "author": "Jonathan Pool <jonathan.pool@jpdev.pro>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/YRA-Tech/testaro/issues"
  },
  "homepage": "https://github.com/YRA-Tech/testaro#readme",
  "dependencies": {
    "@qualweb/act-rules": "^0.8.5",
    "@qualweb/best-practices": "^0.7.13",
    "@qualweb/locale": "^0.2.3",
    "@qualweb/qw-page": "^0.3.8",
    "@qualweb/util": "^0.7.4",
    "@qualweb/wcag-techniques": "^0.4.8",
    "@siteimprove/alfa-act": "^0.119.0",
    "@siteimprove/alfa-playwright": "^0.84.2",
    "@siteimprove/alfa-rules": "^0.119.0",
    "accessibility-checker": "^4.0.30",
    "aria-query": "^5.3.2",
    "aslint-testaro": "^1.0.1",
    "axe-playwright": "^2.2.2",
    "diff": "^9.0.0",
    "dotenv": "^18.0.8",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "pngjs": "^7.0.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "vnu-jar": "^26.8.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "allowScripts": {
    "accessibility-checker": true,
    "puppeteer": true,
    "chromedriver": true,
    "esbuild": true,
    "fsevents": true,
    "vnu-jar": true
  },
  "types": "./types.d.ts",
  "engines": {
    "node": ">=22.12"
  }
}
