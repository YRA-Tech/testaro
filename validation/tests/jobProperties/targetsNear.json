{
  "rule": "targetsNear",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/targetSmall/index.html",
        "what": "page with variously sized interaction targets"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.0",
          "=",
          6
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "targetsNear"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "is less than 44"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "BUTTON"
        ],
        [
          "standardResult.instances.0.catalogEntry.id",
          "=",
          "defaultbutton"
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "Default (small)"
        ],
        [
          "standardResult.instances.2.what",
          "i",
          "is less than"
        ],
        [
          "standardResult.instances.2.catalogEntry.tagName",
          "=",
          "INPUT"
        ],
        [
          "standardResult.instances.2.catalogEntry.text",
          "i",
          "Small box:"
        ],
        [
          "standardResult.instances.2.catalogEntry.box.y",
          ">",
          0
        ],
        [
          "standardResult.instances.4.catalogEntry.tagName",
          "=",
          "A"
        ],
        [
          "standardResult.instances.4.catalogEntry.text",
          "i",
          "Wikimedia Foundation (small)"
        ]
      ],
      "rules": [
        "y",
        "targetsNear"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.0",
          "=",
          6
        ],
        [
          "standardResult.totals.3",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "targetsNear"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "are smaller"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          0
        ],
        [
          "standardResult.instances.0.count",
          "=",
          6
        ]
      ],
      "rules": [
        "y",
        "targetsNear"
      ]
    }
  ]
}
