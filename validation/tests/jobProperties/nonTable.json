{
  "rule": "nonTable",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/nonTable/index.html",
        "what": "page with a real table and 3 pseudotables"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          3
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "nonTable"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "is misused"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "TABLE"
        ],
        [
          "standardResult.instances.0.catalogEntry.box.height",
          ">",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "Given"
        ],
        [
          "standardResult.instances.2.ruleID",
          "=",
          "nonTable"
        ],
        [
          "standardResult.instances.2.catalogEntry.id",
          "=",
          "ring"
        ]
      ],
      "rules": [
        "y",
        "nonTable"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          3
        ],
        [
          "standardResult.totals.0",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "nonTable"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "are misused"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "TABLE"
        ]
      ],
      "rules": [
        "y",
        "nonTable"
      ]
    }
  ]
}
