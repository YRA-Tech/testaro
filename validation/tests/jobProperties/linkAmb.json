{
  "rule": "linkAmb",
  "timeLimit": 20,
  "isolation": "page",
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/linkAmb/index.html",
        "what": "page with unambiguous and ambiguous links"
      }
    },
    {
      "type": "test",
      "launch": {},
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.totals.2",
          "=",
          6
        ],
        [
          "standardResult.instances.length",
          "=",
          2
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "linkAmb"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "links with the accessible name “basque information” have 2 different destinations"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.count",
          "=",
          4
        ],
        [
          "standardResult.instances.0.outcome",
          "=",
          "failed"
        ],
        [
          "standardResult.instances.0.tagName",
          "=",
          "BODY"
        ],
        [
          "standardResult.instances.0.location.doc",
          "=",
          "dom"
        ],
        [
          "standardResult.instances.0.excerpt",
          "i",
          "Basque Country details"
        ],
        [
          "standardResult.instances.1.what",
          "i",
          "links with the accessible name “shared accessible name” have 2 different destinations"
        ],
        [
          "standardResult.instances.1.count",
          "=",
          2
        ]
      ],
      "rules": [
        "y",
        "linkAmb"
      ]
    },
    {
      "type": "test",
      "launch": {},
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.totals.2",
          "=",
          6
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "linkAmb"
        ],
        [
          "standardResult.instances.0.count",
          "=",
          6
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "Links have the same accessible name but different destinations"
        ]
      ],
      "rules": [
        "y",
        "linkAmb"
      ]
    }
  ]
}
