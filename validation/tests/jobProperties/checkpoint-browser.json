{
  "rule": "checkpoint-browser",
  "timeLimit": 120,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/checkpoint/index.html",
        "what": "page whose defects appear after an action"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "rules": [
        "y",
        "altScheme",
        "linkTo"
      ],
      "what": "before the action, at checkpoint 0",
      "expect": [
        [
          "standardResult.instances.length",
          "=",
          0
        ],
        [
          "checkpoint",
          "=",
          0
        ]
      ],
      "stopOnFail": false
    },
    {
      "type": "button",
      "which": "Show more",
      "what": "reveal the defective section"
    },
    {
      "type": "checkpoint",
      "which": "revealed",
      "what": "the page after the section is revealed"
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "rules": [
        "y",
        "altScheme",
        "linkTo"
      ],
      "what": "after the action, at checkpoint 1",
      "expect": [
        [
          "checkpoint",
          "=",
          1
        ],
        [
          "standardResult.instances.length",
          "=",
          2
        ],
        [
          "standardResult.instances.0.checkpoint",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "altScheme"
        ],
        [
          "standardResult.instances.0.tagName",
          "=",
          "IMG"
        ],
        [
          "standardResult.instances.1.ruleID",
          "=",
          "linkTo"
        ],
        [
          "standardResult.instances.1.id",
          "=",
          "noHref"
        ],
        [
          "standardResult.outcomeTotals.failed",
          "=",
          2
        ]
      ],
      "stopOnFail": false
    },
    {
      "type": "test",
      "which": "axe",
      "rules": [
        "image-alt",
        "link-name"
      ],
      "what": "after the action, at checkpoint 1, by axe",
      "expect": [
        [
          "checkpoint",
          "=",
          1
        ],
        [
          "data.replay.acts",
          "=",
          1
        ],
        [
          "data.replay.fidelity",
          "=",
          "exact"
        ],
        [
          "standardResult.instances.length",
          "=",
          2
        ],
        [
          "standardResult.instances.0.checkpoint",
          "=",
          1
        ]
      ],
      "detailLevel": 0
    }
  ],
  "expectReport": [
    [
      "checkpoints.length",
      "=",
      2
    ],
    [
      "checkpoints.1.name",
      "=",
      "revealed"
    ],
    [
      "checkpoints.1.kind",
      "=",
      "interaction"
    ],
    [
      "checkpoints.1.replay",
      "e",
      [
        2
      ]
    ],
    [
      "checkpoints.1.testActs",
      "e",
      [
        4,
        5
      ]
    ],
    [
      "pathIDs"
    ],
    [
      "catalogNextIndex"
    ],
    [
      "jobData.isolation",
      "=",
      "browser"
    ]
  ],
  "isolation": "browser"
}
