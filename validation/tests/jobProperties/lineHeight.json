{
  "rule": "lineHeight",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/lineHeight/index.html",
        "what": "page with various line heights"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          1
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "lineHeight"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "is less than 1.5 times"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          1
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "P"
        ],
        [
          "standardResult.instances.0.catalogEntry.id",
          "=",
          "clip"
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "puny text"
        ]
      ],
      "rules": [
        "y",
        "lineHeight"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          1
        ],
        [
          "standardResult.totals.2",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "lineHeight"
        ],
        [
          "standardResult.instances.0.count",
          "=",
          1
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "less than 1.5 times"
        ]
      ],
      "rules": [
        "y",
        "lineHeight"
      ]
    }
  ]
}
