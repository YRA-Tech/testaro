{
  "rule": "motion",
  "timeLimit": 150,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/motion/bad.html",
        "what": "page with motion"
      }
    },
    {
      "type": "test",
      "launch": {
        "target": {
          "url": "file://validation/tests/targets/motion/bad.html",
          "what": "page with motion at the top"
        }
      },
      "which": "testaro",
      "stopOnFail": false,
      "withItems": true,
      "expect": [
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "motion"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "changes spontaneously and continually"
        ],
        [
          "standardResult.instances.0.outcome",
          "=",
          "failed"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          ">",
          0
        ]
      ],
      "rules": [
        "y",
        "motion"
      ]
    },
    {
