{
  "rule": "title",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/title/good.html",
        "what": "page with a title"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "stopOnFail": true,
      "expect": [
        [
          "data.ruleData.title.title",
          "=",
          "Test page"
        ],
        [
          "standardResult.instances.length",
          "=",
          0
        ]
      ],
      "withItems": true,
      "rules": [
        "y",
        "title"
      ]
    },
    {
      "type": "url",
      "which": "file://validation/tests/targets/title/bad.html",
      "what": "page without a title"
    },
    {
      "type": "test",
      "which": "testaro",
      "stopOnFail": true,
      "expect": [
        [
          "data.ruleData.title.title",
          "=",
          ""
        ],
        [
          "standardResult.instances.length",
          "=",
          0
        ]
      ],
      "withItems": true,
      "rules": [
        "y",
        "title"
      ]
    }
  ],
  "standard": "no"
}
