{
  "rule": "alfaStyles",
  "timeLimit": 30,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/alfaStyles/index.html",
        "what": "page with stylesheets that deny rules to Alfa"
      }
    },
    {
      "type": "test",
      "which": "alfa",
      "reckless": true,
      "expect": [
        [
          "standardResult.prevented",
          "=",
          false
        ],
        [
          "data.styleLosses.length",
          "=",
          1
        ],
        [
          "data.styleLosses.0.sheet",
          "=",
          "inline sheet 1"
        ],
        [
          "data.styleLosses.0.reason",
          "=",
          "unserialized"
        ],
        [
          "data.styleLosses.0.ruleCount",
          "=",
          1
        ],
        [
          "data.sheetCopies.length",
          "=",
          3
        ],
        [
          "data.sheetCopies.0.copyOf",
          "i",
          "imports.css"
        ],
        [
          "data.sheetCopies.0.rules",
          "=",
          2
        ],
        [
          "data.sheetCopies.1.copyOf",
          "=",
          "inline sheet 1"
        ],
        [
          "data.sheetCopies.1.rules",
          "=",
          1
        ],
        [
          "data.sheetCopies.1.omittedRuleCount",
          "=",
          1
        ],
        [
          "data.sheetCopies.2.copyOf",
          "i",
          "usable.css"
        ],
        [
          "data.sheetCopies.2.rules",
          "=",
          3
        ]
      ]
    }
  ]
}
