{
  "rule": "hover",
  "timeLimit": 40,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/hover/good.html",
        "what": "page with standard hover behavior"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.0",
          "=",
          0
        ],
        [
          "standardResult.totals.2",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          0
        ]
      ],
      "rules": [
        "y",
        "hover"
      ],
      "args": {
        "hover": [
          5
        ]
      }
    },
    {
      "type": "url",
      "which": "file://validation/tests/targets/hover/bad.html",
      "what": "page with deviant hover behavior"
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.3",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "hover"
        ],
        [
          "standardResult.instances.length",
          "=",
          3
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "over the element"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "BUTTON"
        ],
        [
          "standardResult.instances.0.catalogEntry.box.height",
          "<",
          "45"
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "Trigger 2"
        ],
        [
          "standardResult.instances.2.what",
          "i",
          "Hovering over the"
        ],
        [
          "standardResult.instances.2.ordinalSeverity",
          "=",
          0
        ],
        [
          "standardResult.instances.2.catalogEntry.tagName",
          "=",
          "SPAN"
        ],
        [
          "standardResult.instances.2.catalogEntry.box.x",
          ">",
          0
        ],
        [
          "standardResult.instances.2.catalogEntry.text",
          "i",
          "Hover over me"
        ]
      ],
      "rules": [
        "y",
        "hover"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.0",
          "=",
          3
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "hover"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "over elements"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          0
        ],
        [
          "standardResult.instances.0.count",
          "=",
          3
        ]
      ],
      "rules": [
        "y",
        "hover"
      ]
    }
  ]
}
