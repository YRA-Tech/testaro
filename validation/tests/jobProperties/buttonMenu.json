{
  "rule": "buttonMenu",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/buttonMenu/good.html",
        "what": "page with standard menu navigation"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.totals.2",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          0
        ]
      ],
      "rules": [
        "y",
        "buttonMenu"
      ]
    },
    {
      "type": "url",
      "which": "file://validation/tests/targets/buttonMenu/bad.html",
      "what": "page with deviant menu navigation"
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "args": {
        "buttonMenu": [
          [
            "End",
            "+",
            "-",
            "-",
            "Home"
          ]
        ]
      },
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          2
        ],
        [
          "standardResult.totals.0",
          "=",
          0
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.totals.3",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "buttonMenu"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "responds nonstandardly to the End key"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "UL"
        ],
        [
          "standardResult.instances.0.catalogEntry.id",
          "=",
          "persMenu"
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "Personalities"
        ],
        [
          "standardResult.instances.1.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.1.catalogEntry.tagName",
          "=",
          "UL"
        ],
        [
          "standardResult.instances.1.catalogEntry.id",
          "=",
          "techMenu"
        ],
        [
          "standardResult.instances.1.catalogEntry.text",
          "i",
          "Technologies"
        ]
      ],
      "rules": [
        "y",
        "buttonMenu"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "args": {
        "buttonMenu": [
          [
            "End",
            "+",
            "-",
            "-",
            "Home"
          ]
        ]
      },
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          2
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.totals.0",
          "=",
          0
        ],
        [
          "standardResult.totals.3",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "i",
          "buttonMenu"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "behave nonstandardly"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.count",
          "=",
          2
        ]
      ],
      "rules": [
        "y",
        "buttonMenu"
      ]
    }
  ]
}
