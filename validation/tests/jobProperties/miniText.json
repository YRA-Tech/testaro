{
  "rule": "miniText",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/miniText/index.html",
        "what": "page with text in various font sizes"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          3
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "miniText"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "font size is 8px"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "P"
        ],
        [
          "standardResult.instances.0.catalogEntry.box.y",
          ">",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "in rem"
        ],
        [
          "standardResult.instances.1.catalogEntry.text",
          "i",
          "in px"
        ],
        [
          "standardResult.instances.1.what",
          "i",
          "font size is 7px"
        ],
        [
          "standardResult.instances.2.catalogEntry.text",
          "i",
          "with a named constant"
        ]
      ],
      "rules": [
        "y",
        "miniText"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          3
        ],
        [
          "standardResult.totals.0",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "miniText"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "have font sizes smaller"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ]
      ],
      "rules": [
        "y",
        "miniText"
      ]
    }
  ]
}
