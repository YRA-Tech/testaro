{
  "rule": "radioSet",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/radioSet/good.html",
        "what": "page with standard radio-button grouping"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "what": "radioSet",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          0
        ]
      ],
      "rules": [
        "y",
        "radioSet"
      ]
    },
    {
      "type": "url",
      "which": "file://validation/tests/targets/radioSet/bad.html",
      "what": "page with deviant radio-button grouping"
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          11
        ],
        [
          "standardResult.totals.3",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "radioSet"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "shares a field set"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "INPUT"
        ],
        [
          "standardResult.instances.0.catalogEntry.box.width",
          ">",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "water"
        ],
        [
          "standardResult.instances.5.ruleID",
          "=",
          "radioSet"
        ],
        [
          "standardResult.instances.5.what",
          "i",
          "without a valid legend"
        ],
        [
          "standardResult.instances.5.catalogEntry.text",
          "i",
          "apple"
        ],
        [
          "standardResult.instances.6.what",
          "i",
          "not in a field set"
        ],
        [
          "standardResult.instances.6.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.6.catalogEntry.text",
          "i",
          "methane"
        ],
        [
          "standardResult.instances.8.what",
          "i",
          "the only one with its name"
        ],
        [
          "standardResult.instances.10.what",
          "i",
          "shares a name with others outside"
        ]
      ],
      "rules": [
        "y",
        "radioSet"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.2",
          "=",
          11
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "radioSet"
        ],
        [
          "standardResult.instances.0.what",
          "i",
          "are not validly grouped"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          2
        ],
        [
          "standardResult.instances.0.count",
          "=",
          11
        ]
      ],
      "rules": [
        "y",
        "radioSet"
      ]
    }
  ]
}
