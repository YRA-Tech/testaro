        [
          "standardResult.instances.0.location.doc",
          "=",
          "dom"
        ],
        [
          "standardResult.instances.0.location.type",
          "=",
          "selector"
        ],
        [
          "standardResult.instances.0.location.spec",
          "=",
          "#basqueInfo"
        ],
        [
          "standardResult.instances.0.excerpt",
          "i",
          "Basque information"
        ]
      ],
      "rules": [
