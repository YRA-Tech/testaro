{
  "rule": "captionLoc",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/captionLoc/index.html",
        "what": "page with standard and nonstandard caption locations"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.3",
          "=",
          2
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "captionLoc"
        ],
        [
          "standardResult.instances.0.what",
          "=",
          "Element is not the first child of a table element"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          3
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "CAPTION"
        ],
        [
          "standardResult.instances.0.catalogEntry.box.width",
          ">",
          0
        ],
        [
          "standardResult.instances.0.catalogEntry.text",
          "i",
          "Office personnel"
        ],
        [
          "standardResult.instances.1.catalogEntry.text",
          "i",
          "Farm personnel"
        ]
      ],
      "rules": [
        "y",
        "captionLoc"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.3",
          "=",
          2
        ],
        [
          "standardResult.totals.1",
          "=",
          0
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.ruleID",
          "=",
          "captionLoc"
        ],
        [
          "standardResult.instances.0.what",
          "=",
          "caption elements are not the first children of table elements"
        ],
        [
          "standardResult.instances.0.ordinalSeverity",
          "=",
          3
        ],
        [
          "standardResult.instances.0.count",
          "=",
          2
        ],
        [
          "standardResult.instances.0.catalogEntry.tagName",
          "=",
          "CAPTION"
        ]
      ],
      "rules": [
        "y",
        "captionLoc"
      ]
    }
  ]
}
