{
  "rule": "distortion",
  "timeLimit": 20,
  "acts": [
    {
      "type": "launch",
      "target": {
        "url": "file://validation/tests/targets/distortion/index.html",
        "what": "page with distorted text"
      }
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": true,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          5
        ],
        [
          "standardResult.instances.length",
          "=",
          5
        ],
        [
          "standardResult.instances.1.what",
          "i",
          "Element distorts"
        ],
        [
          "standardResult.instances.1.catalogEntry.tagName",
          "=",
          "P"
        ],
        [
          "standardResult.instances.1.catalogEntry.id",
          "=",
          "matrixp"
        ],
        [
          "standardResult.instances.2.catalogEntry.text",
          "i",
          "z-axis"
        ],
        [
          "standardResult.instances.3.ordinalSeverity",
          "=",
          1
        ],
        [
          "standardResult.instances.4.catalogEntry.tagName",
          "=",
          "SPAN"
        ]
      ],
      "rules": [
        "y",
        "distortion"
      ]
    },
    {
      "type": "test",
      "which": "testaro",
      "withItems": false,
      "stopOnFail": true,
      "expect": [
        [
          "standardResult.totals.1",
          "=",
          5
        ],
        [
          "standardResult.instances.length",
          "=",
          1
        ],
        [
          "standardResult.instances.0.count",
          "=",
          5
        ]
      ],
      "rules": [
        "y",
        "distortion"
      ]
    }
  ]
}
